import rospy
from sensor_msgs.msg import Imu
from std_msgs.msg import Float64
import numpy as np

class FallDetection:
    def __init__(self):
        rospy.Subscriber("/robotis_op3/imu", Imu, self.imu_callback)
        self.is_fallen = False
        self.threshold = 0.5  # Ajuste conforme necessário

    def imu_callback(self, data):
        acc = data.linear_acceleration
        acc_vector = np.array([acc.x, acc.y, acc.z])
        acc_magnitude = np.linalg.norm(acc_vector)

        # Verifica se o robô caiu
        if acc_magnitude < self.threshold:
            self.is_fallen = True
        else:
            self.is_fallen = False

    def is_robot_fallen(self):
        return self.is_fallen

class GetUp:
    def __init__(self):
        # Publicadores para as articulações
        self.joint_publishers = {
            'r_shoulder_pitch': rospy.Publisher('/robotis_op3/r_shoulder_pitch_position/command', Float64, queue_size=10),
            'l_shoulder_pitch': rospy.Publisher('/robotis_op3/l_shoulder_pitch_position/command', Float64, queue_size=10),
            'r_shoulder_roll': rospy.Publisher('/robotis_op3/r_shoulder_roll_position/command', Float64, queue_size=10),
            'l_shoulder_roll': rospy.Publisher('/robotis_op3/l_shoulder_roll_position/command', Float64, queue_size=10),
            'r_elbow': rospy.Publisher('/robotis_op3/r_elbow_position/command', Float64, queue_size=10),
            'l_elbow': rospy.Publisher('/robotis_op3/l_elbow_position/command', Float64, queue_size=10),
            'r_hip_yaw': rospy.Publisher('/robotis_op3/r_hip_yaw_position/command', Float64, queue_size=10),
            'l_hip_yaw': rospy.Publisher('/robotis_op3/l_hip_yaw_position/command', Float64, queue_size=10),
            'r_hip_roll': rospy.Publisher('/robotis_op3/r_hip_roll_position/command', Float64, queue_size=10),
            'l_hip_roll': rospy.Publisher('/robotis_op3/l_hip_roll_position/command', Float64, queue_size=10),
            'r_hip_pitch': rospy.Publisher('/robotis_op3/r_hip_pitch_position/command', Float64, queue_size=10),
            'l_hip_pitch': rospy.Publisher('/robotis_op3/l_hip_pitch_position/command', Float64, queue_size=10),
            'r_knee': rospy.Publisher('/robotis_op3/r_knee_position/command', Float64, queue_size=10),
            'l_knee': rospy.Publisher('/robotis_op3/l_knee_position/command', Float64, queue_size=10),
            'r_ankle_pitch': rospy.Publisher('/robotis_op3/r_ankle_pitch_position/command', Float64, queue_size=10),
            'l_ankle_pitch': rospy.Publisher('/robotis_op3/l_ankle_pitch_position/command', Float64, queue_size=10),
            'r_ankle_roll': rospy.Publisher('/robotis_op3/r_ankle_roll_position/command', Float64, queue_size=10),
            'l_ankle_roll': rospy.Publisher('/robotis_op3/l_ankle_roll_position/command', Float64, queue_size=10),
        }

    def get_up(self):
        # Sequência de ângulos para levantar o robô
        # Exemplo de sequência - ajustar conforme necessário
        sequences = [
            {'r_shoulder_pitch': -1.0, 'l_shoulder_pitch': -1.0, 'r_hip_pitch': 1.0, 'l_hip_pitch': 1.0},  # Preparação inicial
            {'r_shoulder_pitch': -0.5, 'l_shoulder_pitch': -0.5, 'r_knee': -1.0, 'l_knee': -1.0},  # Início do levantamento
            {'r_shoulder_pitch': 0.0, 'l_shoulder_pitch': 0.0, 'r_knee': 0.0, 'l_knee': 0.0},  # Levantamento completo
        ]

        for step in sequences:
            for joint, position in step.items():
                self.joint_publishers[joint].publish(Float64(position))
                rospy.sleep(0.5)  # Tempo de espera para permitir o movimento

if __name__ == '__main__':
    rospy.init_node('fall_detection_and_getup_darwin_op3')

    fall_detection = FallDetection()
    get_up_controller = GetUp()

    rate = rospy.Rate(10)  # 10 Hz
    while not rospy.is_shutdown():
        if fall_detection.is_robot_fallen():
            rospy.loginfo("Robô caiu! Iniciando sequência de levantamento.")
            get_up_controller.get_up()
        rate.sleep()
